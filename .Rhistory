myrec <- ZenodoRecord$new()
myrec$setTitle("Example raw quantification outputs used for extracting view data")
myrec$setDescription("This data contains the raw quantification outputs from platforms
FragPipe, Maxquant, DIA-NN and Spectronaut. We use them as inputs
for extracting view data serving as inputs to our newly designed
multi-view proteomics framework.")
myrec$setUploadType("dataset")
myrec$addCreator(firstname = "Hui", lastname = "Peng", affiliation = "Nanyang Technological University", orcid = "0000-0002-5137-1827")
myrec$setLicense("mit")
#myrec$setAccessRight("open")
#myrec$setDOI("10.5281/zenodo.10478565") #use this method if your DOI has been assigned elsewhere, outside Zenodo
#myrec$addCommunity("")
myrec <- zenodo$depositRecord(myrec)
zenodo$uploadFile("E:/proteomics/maus2/submission/submission/final/upload/OpDEA/server/Example_data/Example_view_extraction_data.zip", record = myrec)
